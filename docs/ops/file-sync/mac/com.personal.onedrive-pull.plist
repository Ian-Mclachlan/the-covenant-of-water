<?xml version="1.0" encoding="UTF-8"?>
<!--
  Install:
    mkdir -p ~/bin ~/Library/LaunchAgents
    cp pull-from-onedrive.sh ~/bin/
    chmod +x ~/bin/pull-from-onedrive.sh
    sed "s|__HOME__|$HOME|g" com.personal.onedrive-pull.plist \
      > ~/Library/LaunchAgents/com.personal.onedrive-pull.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.personal.onedrive-pull.plist

  Run it now:      launchctl kickstart -k gui/$(id -u)/com.personal.onedrive-pull
  Check it exists: launchctl print gui/$(id -u)/com.personal.onedrive-pull
  Remove:          launchctl bootout gui/$(id -u)/com.personal.onedrive-pull

  Fires at 07:30 and again at 18:30. RunAtLoad also fires it at login, which
  covers the case where the MacBook was closed at both scheduled times.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personal.onedrive-pull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/bin/pull-from-onedrive.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>18</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/PersonalSync/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/PersonalSync/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
